{
  "name": "the-universe-workspace",
  "version": "0.3.0",
  "private": true,
  "description": "THE UNIVERSE — Homepage, language foundation and mobile 3D prototype (Package 03)",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @the-universe/web",
    "build": "npm run build --workspace @the-universe/web",
    "start": "npm run start --workspace @the-universe/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspace @the-universe/web",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.6",
    "typescript": "^5.9.2",
    "@types/three": "^0.180.0",
    "@eslint/eslintrc": "^3.3.1"
  }
}
